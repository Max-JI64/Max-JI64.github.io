---
import { getCollection } from "astro:content";
import AwardTrophy from "../components/AwardTrophy.astro";
import ContentThumbnail from "../components/ContentThumbnail.astro";
import HeroDataNetworkCandidate2 from "../components/HeroDataNetworkCandidate2.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatArchivePeriod } from "../utils/formatDate";

const sortByPublishedAt = <T extends { data: { publishedAt: Date } }>(entries: T[]) =>
  [...entries].sort((left, right) => right.data.publishedAt.valueOf() - left.data.publishedAt.valueOf());

const getPeriodEndValue = (period: string) => {
  const dates = [...period.matchAll(/(\d{4})\D+(\d{1,2})\D+(\d{1,2})/g)];
  const latest = dates.at(-1);
  return latest ? Date.UTC(Number(latest[1]), Number(latest[2]) - 1, Number(latest[3])) : Number.NEGATIVE_INFINITY;
};

const notes = sortByPublishedAt(await getCollection("notes", ({ data }) => !data.draft));
const projects = sortByPublishedAt(await getCollection("projects", ({ data }) => !data.draft));
const experiences = [...await getCollection("experiences", ({ data }) => !data.draft)].sort(
  (left, right) => right.data.startedAt.valueOf() - left.data.startedAt.valueOf(),
);
const latestEntry = [
  ...notes.map((entry) => ({ kind: "학습 노트", title: entry.data.title, description: entry.data.description, href: `/notes/${entry.id}/`, modifiedAt: entry.data.updatedAt ?? entry.data.publishedAt })),
  ...projects.filter((entry) => entry.data.homeRecent).map((entry) => ({ kind: "프로젝트", title: entry.data.title, description: entry.data.description, href: `/projects/${entry.id}/`, modifiedAt: entry.data.updatedAt ?? entry.data.publishedAt })),
  ...experiences.filter((entry) => entry.data.homeRecent).map((entry) => ({ kind: "경험 & 자격증", title: entry.data.title, description: entry.data.description, href: `/experiences/${entry.id}/`, modifiedAt: entry.data.updatedAt ?? entry.data.publishedAt })),
].sort((left, right) => right.modifiedAt.valueOf() - left.modifiedAt.valueOf())[0];
const featuredProject = projects.find((entry) => entry.data.featured);
const highlightedProject = featuredProject ?? projects[0];
const highlightedProjectLabel = featuredProject ? "대표 프로젝트" : "최근 프로젝트";
const supportingProjects = projects
  .filter((entry) => entry.id !== highlightedProject?.id)
  .sort((left, right) =>
    getPeriodEndValue(right.data.period) - getPeriodEndValue(left.data.period)
    || right.data.publishedAt.valueOf() - left.data.publishedAt.valueOf()
  );

---

<BaseLayout
  title="Max.JI의 빅데이터 프로젝트 아카이브"
  description="학습 노트와 데이터 프로젝트의 과정 및 판단을 정리하는 개인 아카이브입니다."
>
  <section class="hero-scene" aria-labelledby="hero-title">
    <HeroDataNetworkCandidate2 />
    <div class="shell hero">
      <div class="hero-copy">
        <p class="kicker">Learning archive and project record</p>
        <h1 id="hero-title">데이터를 배우고,<br />분석하고,<br /><span>기록합니다.</span></h1>
        <p class="hero-description">학습 노트와 데이터 프로젝트의 과정 및 판단을 정리하는 개인 아카이브입니다.</p>
        <div class="action-row">
          <a class="button button-primary" href="/notes/">학습 노트 보기</a>
          <a class="button button-secondary" href="/projects/">프로젝트 보기</a>
        </div>
      </div>

      <section class="latest-note-area" aria-labelledby="latest-note-heading">
        <h2 id="latest-note-heading">최근 업로드</h2>
        {
          latestEntry ? (
            <a class="latest-note-preview" href={latestEntry.href} aria-label={`최근 업로드: ${latestEntry.kind} ${latestEntry.title}`}>
              <div class="latest-note-copy"><p class="latest-note-topic">{latestEntry.kind}</p><h3>{latestEntry.title}</h3><p>{latestEntry.description}</p><span class="text-link">페이지 보기 <span aria-hidden="true">→</span></span></div>
            </a>
          ) : (
            <div class="latest-note-preview latest-note-empty" aria-label="최근 업로드 없음"><h3>첫 페이지를<br />작성해 보세요.</h3><p>프로젝트, 경험, 학습 노트 중 하나를 추가하거나 수정하면 이 자리에 자동으로 표시됩니다.</p><a class="text-link" href="/projects/">프로젝트 보기 <span aria-hidden="true">→</span></a></div>
          )
        }
      </section>
    </div>
  </section>

  <section class="section section-border" aria-labelledby="projects-title">
    <div class="shell">
      <div class="section-heading project-section-heading">
        <h2 id="projects-title">프로젝트</h2>
        <a class="text-link" href="/projects/">전체 프로젝트 {projects.length}개 보기 <span aria-hidden="true">→</span></a>
      </div>
      {
        highlightedProject ? (
          <a class="project-feature" href={`/projects/${highlightedProject.id}/`}>
            <ContentThumbnail src={highlightedProject.data.thumbnail} alt={`${highlightedProject.data.title} 대표 이미지`} label={highlightedProject.data.category || "PROJECT"} className="project-feature-thumbnail" />
            <div class="project-copy">
              <p class="project-status">{highlightedProjectLabel}</p>
              <h3>{highlightedProject.data.title}</h3>
              {highlightedProject.data.description && <p>{highlightedProject.data.description}</p>}
              <div class="project-meta">
                <time><strong>기간</strong> {highlightedProject.data.period}</time>
                {highlightedProject.data.award && <span class="project-award-tag">{highlightedProject.data.award} 수상</span>}
              </div>
            </div>
            {highlightedProject.data.award && <AwardTrophy award={highlightedProject.data.award} variant="featured" />}
          </a>
        ) : (
          <p class="empty-state">아직 프로젝트가 없습니다. <code>src/content/projects/</code>에 Markdown 파일을 추가해 보세요.</p>
        )
      }
      {
        supportingProjects.length > 0 && (
          <div class="home-project-carousel" data-home-project-carousel>
            <div class="home-carousel-toolbar">
              <p class="home-carousel-summary">
                <strong>다른 프로젝트</strong>
                <span data-home-project-status role="status" aria-live="polite" aria-atomic="true">
                  1{supportingProjects.length > 1 ? `–${Math.min(2, supportingProjects.length)}` : ""} / {supportingProjects.length}
                </span>
              </p>
              {supportingProjects.length > 1 && (
                <div class="home-carousel-controls" aria-label="다른 프로젝트 이동">
                  <button class="home-carousel-button" type="button" data-home-project-prev aria-label="이전 프로젝트" aria-controls="home-project-track">←</button>
                  <button class="home-carousel-button home-carousel-button--next" type="button" data-home-project-next aria-label="다음 프로젝트" aria-controls="home-project-track">→</button>
                </div>
              )}
            </div>
            <div id="home-project-track" class="project-row" data-home-project-track>
              {supportingProjects.map((project) => (
                <a class="project-card" href={`/projects/${project.id}/`}>
                  <ContentThumbnail src={project.data.thumbnail} alt={`${project.data.title} 대표 이미지`} label={project.data.category || "PROJECT"} className="project-card-thumbnail" />
                  <div>{project.data.category && <small>{project.data.category}</small>}<h3>{project.data.title}</h3>{project.data.description && <p>{project.data.description}</p>}<div class="project-card-meta"><time>기간 {project.data.period}</time>{project.data.award && <span class="project-award-tag">{project.data.award} 수상</span>}</div></div>
                  {project.data.award && <AwardTrophy award={project.data.award} />}
                  <span class="text-link">기록 보기 <span aria-hidden="true">→</span></span>
                </a>
              ))}
            </div>
          </div>
        )
      }
    </div>
  </section>

  <section class="section section-border" aria-label="경험 및 자격증과 학습 노트">
    <div class="shell experience-notes-grid">
      <section aria-labelledby="experience-title">
        <div class="record-heading"><h2 id="experience-title">경험 &amp; 자격증</h2><a class="text-link" href="/experiences/">전체 {experiences.length}개 보기 <span aria-hidden="true">→</span></a></div>
        {
          experiences.length > 0 ? (
            <div class="home-experience-carousel" data-home-experience-carousel>
              <div class="home-carousel-toolbar">
                <p class="home-carousel-summary"><strong>활동 기록</strong><span data-home-experience-status role="status" aria-live="polite" aria-atomic="true">1 / {experiences.length}</span></p>
                <div class="home-carousel-controls" aria-label="경험 및 자격증 이동">
                  <button class="home-carousel-button" type="button" data-home-experience-prev aria-label="이전 경험" aria-controls="home-experience-track">↑</button>
                  <button class="home-carousel-button home-carousel-button--next" type="button" data-home-experience-next aria-label="다음 경험" aria-controls="home-experience-track">↓</button>
                </div>
              </div>
              <div id="home-experience-track" class="home-experience-grid" data-home-experience-track>
              {experiences.map((experience) => (
                <a class="experience-card" href={`/experiences/${experience.id}/`}>
                  <ContentThumbnail src={experience.data.thumbnail} alt={`${experience.data.title} 대표 이미지`} label={experience.data.kind} className="experience-card-thumbnail" />
                  <span class="experience-card-copy"><strong>{experience.data.title}</strong><small>{experience.data.organization} · {experience.data.kind}</small><time datetime={experience.data.startedAt.toISOString()}>{formatArchivePeriod(experience.data.startedAt, experience.data.endedAt)}</time></span>
                </a>
              ))}
              </div>
            </div>
          ) : (
            <p class="empty-state"><code>src/content/experiences/</code>에 활동, 인턴, 교육 경험을 Markdown으로 추가할 수 있습니다.</p>
          )
        }
      </section>

      <section aria-labelledby="learning-title">
        <div class="record-heading"><h2 id="learning-title">학습 노트</h2><a class="text-link" href="/notes/">전체 {notes.length}개 보기 <span aria-hidden="true">→</span></a></div>
        <div class="home-note-carousel" data-home-note-carousel>
          <div class="home-carousel-toolbar">
            <p class="home-carousel-summary"><strong>학습 기록</strong><span data-home-note-status role="status" aria-live="polite" aria-atomic="true">{notes.length > 1 ? `1–${Math.min(5, notes.length)} / ${notes.length}` : notes.length === 1 ? "1 / 1" : "0 / 0"}</span></p>
            <div class="home-carousel-controls" aria-label="학습 노트 이동">
              <button class="home-carousel-button" type="button" data-home-note-prev aria-label="이전 학습 노트" aria-controls="home-note-track">↑</button>
              <button class="home-carousel-button home-carousel-button--next" type="button" data-home-note-next aria-label="다음 학습 노트" aria-controls="home-note-track">↓</button>
            </div>
          </div>
          <div id="home-note-track" class="home-note-list" data-home-note-track>
          {notes.map((note) => (
            <a href={`/notes/${note.id}/`}>
              <span><strong>{note.data.title}</strong><small>{note.data.description}</small></span>
            </a>
          ))}
          </div>
        </div>
      </section>
    </div>
  </section>

</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>("[data-home-project-carousel]").forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>("[data-home-project-track]");
    const previous = carousel.querySelector<HTMLButtonElement>("[data-home-project-prev]");
    const next = carousel.querySelector<HTMLButtonElement>("[data-home-project-next]");
    const status = carousel.querySelector<HTMLElement>("[data-home-project-status]");
    const cards = [...carousel.querySelectorAll<HTMLElement>(".project-card")];

    if (!track || cards.length === 0) return;

    const measure = () => {
      const cardWidth = cards[0].offsetWidth;
      const step = cards.length > 1 ? Math.max(cards[1].offsetLeft - cards[0].offsetLeft, cardWidth) : cardWidth;
      const gap = Math.max(step - cardWidth, 0);
      const visibleCount = Math.max(1, Math.floor((track.clientWidth + gap + 1) / Math.max(step, 1)));
      const firstIndex = Math.min(cards.length - 1, Math.max(0, Math.round(track.scrollLeft / Math.max(step, 1))));
      return { firstIndex, step, visibleCount };
    };

    const updateControls = () => {
      const { firstIndex, visibleCount } = measure();
      const endReached = track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;
      if (previous) previous.disabled = track.scrollLeft <= 2;
      if (next) next.disabled = endReached;

      if (status) {
        const lastIndex = Math.min(cards.length, firstIndex + visibleCount);
        const range = lastIndex > firstIndex + 1 ? `${firstIndex + 1}–${lastIndex}` : `${firstIndex + 1}`;
        const nextStatus = `${range} / ${cards.length}`;
        if (status.textContent?.trim() !== nextStatus) status.textContent = nextStatus;
      }
    };

    const scrollProjects = (direction: number) => {
      const { step } = measure();
      track.scrollBy({ left: direction * step, behavior: "smooth" });
    };

    previous?.addEventListener("click", () => scrollProjects(-1));
    next?.addEventListener("click", () => scrollProjects(1));
    track.addEventListener("scroll", updateControls, { passive: true });
    window.addEventListener("resize", updateControls);
    updateControls();
  });

  document.querySelectorAll<HTMLElement>("[data-home-experience-carousel]").forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>("[data-home-experience-track]");
    const previous = carousel.querySelector<HTMLButtonElement>("[data-home-experience-prev]");
    const next = carousel.querySelector<HTMLButtonElement>("[data-home-experience-next]");
    const status = carousel.querySelector<HTMLElement>("[data-home-experience-status]");
    const cards = [...carousel.querySelectorAll<HTMLElement>(".experience-card")];

    if (!track || cards.length === 0) return;

    const visibleCardIndexes = () => cards
      .map((card, index) => ({ index, top: card.offsetTop, bottom: card.offsetTop + card.offsetHeight }))
      .filter(({ top, bottom }) => bottom > track.scrollTop + 2 && top < track.scrollTop + track.clientHeight - 2)
      .map(({ index }) => index);

    const updateControls = () => {
      const endReached = track.scrollTop + track.clientHeight >= track.scrollHeight - 2;
      if (previous) previous.disabled = track.scrollTop <= 2;
      if (next) next.disabled = endReached;

      if (status) {
        const visible = visibleCardIndexes();
        const first = (visible[0] ?? 0) + 1;
        const last = (visible.at(-1) ?? 0) + 1;
        const range = last > first ? `${first}–${last}` : `${first}`;
        const nextStatus = `${range} / ${cards.length}`;
        if (status.textContent?.trim() !== nextStatus) status.textContent = nextStatus;
      }
    };

    const scrollExperiences = (direction: number) => {
      const step = cards.length > 1
        ? Math.max(cards[1].offsetTop - cards[0].offsetTop, cards[0].offsetHeight)
        : cards[0].offsetHeight;
      track.scrollBy({ top: direction * step, behavior: "smooth" });
    };

    previous?.addEventListener("click", () => scrollExperiences(-1));
    next?.addEventListener("click", () => scrollExperiences(1));
    track.addEventListener("scroll", updateControls, { passive: true });
    window.addEventListener("resize", updateControls);
    updateControls();
  });

  document.querySelectorAll<HTMLElement>("[data-home-note-carousel]").forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>("[data-home-note-track]");
    const previous = carousel.querySelector<HTMLButtonElement>("[data-home-note-prev]");
    const next = carousel.querySelector<HTMLButtonElement>("[data-home-note-next]");
    const status = carousel.querySelector<HTMLElement>("[data-home-note-status]");
    const items = [...carousel.querySelectorAll<HTMLElement>(".home-note-list > a")];

    if (!track) return;

    if (items.length === 0) {
      if (previous) previous.disabled = true;
      if (next) next.disabled = true;
      if (status) status.textContent = "0 / 0";
      return;
    }

    const visibleItemIndexes = () => items
      .map((item, index) => ({ index, top: item.offsetTop, bottom: item.offsetTop + item.offsetHeight }))
      .filter(({ top, bottom }) => bottom > track.scrollTop + 2 && top < track.scrollTop + track.clientHeight - 2)
      .map(({ index }) => index);

    const updateControls = () => {
      const endReached = track.scrollTop + track.clientHeight >= track.scrollHeight - 2;
      if (previous) previous.disabled = track.scrollTop <= 2;
      if (next) next.disabled = endReached;

      if (status) {
        const visible = visibleItemIndexes();
        const first = (visible[0] ?? 0) + 1;
        const last = (visible.at(-1) ?? 0) + 1;
        const range = last > first ? `${first}–${last}` : `${first}`;
        const nextStatus = `${range} / ${items.length}`;
        if (status.textContent?.trim() !== nextStatus) status.textContent = nextStatus;
      }
    };

    const scrollNotes = (direction: number) => {
      const step = items.length > 1
        ? Math.max(items[1].offsetTop - items[0].offsetTop, items[0].offsetHeight)
        : items[0]?.offsetHeight ?? 92;
      track.scrollBy({ top: direction * step, behavior: "smooth" });
    };

    previous?.addEventListener("click", () => scrollNotes(-1));
    next?.addEventListener("click", () => scrollNotes(1));
    track.addEventListener("scroll", updateControls, { passive: true });
    window.addEventListener("resize", updateControls);
    updateControls();
  });
</script>
