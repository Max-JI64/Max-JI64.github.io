---
import { getCollection } from "astro:content";
import AwardTrophy from "../../components/AwardTrophy.astro";
import ContentThumbnail from "../../components/ContentThumbnail.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const getPeriodEndValue = (period: string) => {
  const dates = [...period.matchAll(/(\d{4})\D+(\d{1,2})\D+(\d{1,2})/g)];
  const latest = dates.at(-1);
  return latest ? Date.UTC(Number(latest[1]), Number(latest[2]) - 1, Number(latest[3])) : Number.NEGATIVE_INFINITY;
};

const projects = (await getCollection("projects", ({ data }) => !data.draft)).sort((left, right) =>
  getPeriodEndValue(right.data.period) - getPeriodEndValue(left.data.period)
  || right.data.publishedAt.valueOf() - left.data.publishedAt.valueOf()
);
---

<BaseLayout title="프로젝트 | Max.JI의 빅데이터 프로젝트 아카이브" description="데이터 문제를 정의하고 분석과 모델링으로 답을 찾아간 프로젝트 기록입니다.">
  <section class="shell archive-page" aria-labelledby="page-title">
    <header class="page-intro"><p class="kicker">Projects</p><h1 id="page-title">프로젝트</h1><p>문제 정의, 데이터, 분석 과정, 결과와 회고까지 실제 경험의 맥락을 기록합니다.</p></header>
    {
      projects.length > 0 ? (
        <div class="experience-list project-archive-list">
          {projects.map((project) => (
            <a href={`/projects/${project.id}/`}>
              <ContentThumbnail src={project.data.thumbnail} alt={`${project.data.title} 대표 이미지`} label={project.data.category || "PROJECT"} className="experience-list-thumbnail project-archive-thumbnail" />
              <div class="project-archive-copy">{project.data.category && <p class="project-status">{project.data.category}</p>}<h2>{project.data.title}</h2>{project.data.description && <p>{project.data.description}</p>}</div>
              <div class="experience-list-meta project-archive-meta">
                <time>기간 {project.data.period}</time>
                {project.data.role && <span>{project.data.role}</span>}
                {project.data.award && <span class="project-award-tag">{project.data.award} 수상</span>}
                {project.data.award && <AwardTrophy award={project.data.award} variant="list" />}
                <span aria-hidden="true">→</span>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p class="empty-state"><code>src/content/projects/</code>에 Markdown 파일을 추가하면 프로젝트가 이곳에 표시됩니다.</p>
      )
    }
  </section>
</BaseLayout>
