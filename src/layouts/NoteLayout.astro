---
import BaseLayout from "./BaseLayout.astro";
import ContentToc from "../components/ContentToc.astro";

const { entry, Content, headings = [] } = Astro.props;
const tocHeadings = headings.filter((heading: { depth: number }) => heading.depth === 2);
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: entry.data.title,
  description: entry.data.description,
  url: new URL(Astro.url.pathname, Astro.site).href,
  inLanguage: "ko-KR",
  datePublished: entry.data.publishedAt.toISOString(),
  author: { "@type": "Person", name: "Max.JI", url: "https://max-ji64.github.io/" },
  keywords: entry.data.keywords.join(", ") || undefined,
};
---

<BaseLayout title={`${entry.data.title} | Max.JI의 빅데이터 프로젝트 아카이브`} description={entry.data.description} structuredData={structuredData}>
  <article id="content-top" class:list={["content-page", "shell", "note-content-page", { "has-content-toc": tocHeadings.length > 0 }]}>
    <header class="content-hero content-hero-card">
      <a class="back-link" href="/notes/">← 학습 노트</a>
      <h1>{entry.data.title}</h1>
      <p class="content-description">{entry.data.description}</p>
    </header>
    {entry.data.cover && <img class="content-cover" src={entry.data.cover} alt={`${entry.data.title} 대표 이미지`} />}
    <div class:list={["content-body-shell", { "content-body-shell-with-toc": tocHeadings.length > 0 }]}>
      <ContentToc headings={tocHeadings} />
      <div class="prose document-surface"><Content /></div>
    </div>
  </article>
</BaseLayout>
