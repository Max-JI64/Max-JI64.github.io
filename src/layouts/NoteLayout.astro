---
import BaseLayout from "./BaseLayout.astro";

const { entry, Content } = Astro.props;
const formatDate = (date: Date) => `${date.getFullYear()}년 ${String(date.getMonth() + 1).padStart(2, "0")}월 ${String(date.getDate()).padStart(2, "0")}일`;
const publishedAt = formatDate(entry.data.publishedAt);
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: entry.data.title,
  description: entry.data.description,
  url: new URL(Astro.url.pathname, Astro.site).href,
  inLanguage: "ko-KR",
  datePublished: entry.data.publishedAt.toISOString(),
  author: { "@type": "Person", name: "Max.JI", url: "https://max-ji64.github.io/" },
  keywords: entry.data.keywords.join(", ") || undefined,
};
---

<BaseLayout title={`${entry.data.title} | Max.JI의 빅데이터 프로젝트 아카이브`} description={entry.data.description} structuredData={structuredData}>
  <article class="content-page shell">
    <header class="content-hero content-hero-card">
      <a class="back-link" href="/notes/">← 학습 노트</a>
      <p class="content-category">{entry.data.section}</p>
      <h1>{entry.data.title}</h1>
      <p class="content-description">{entry.data.description}</p>
      <div class="content-meta">
        <time datetime={entry.data.publishedAt.toISOString()}>작성일 {publishedAt}</time>
      </div>
    </header>
    {entry.data.cover && <img class="content-cover" src={entry.data.cover} alt={`${entry.data.title} 대표 이미지`} />}
    <div class="prose document-surface"><Content /></div>
  </article>
</BaseLayout>
