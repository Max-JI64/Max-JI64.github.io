---
interface Props {
  src?: string;
  alt: string;
  label: string;
  className?: string;
}

const { src, alt, label, className } = Astro.props;
---

<div class:list={["content-thumbnail", className]}>
  {
    src ? (
      <img src={src} alt={alt} loading="lazy" />
    ) : (
      <span class="content-thumbnail-fallback" aria-hidden="true">{label}</span>
    )
  }
</div>
